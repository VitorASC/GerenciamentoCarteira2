    {
      "name": "Ciclo de sessões",
      "description": "Execute as chamadas de cada pasta na ordem indicada, com as credenciais PADRAO do ambiente local.",
      "item": [
        {
          "name": "Rotação e replay",
          "item": [
            {
              "name": "Login",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/auth/login",
                "auth": {
                  "type": "noauth"
                },
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"{{email_padrao}}\",\n  \"senha\": \"{{senha_padrao}}\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                      "if (pm.response.code === 200) {",
                      "    const resposta = pm.response.json();",
                      "    pm.collectionVariables.set(\"accessToken\", resposta.accessToken);",
                      "    pm.collectionVariables.set(\"refreshToken\", resposta.refreshToken);",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Renovar e guardar a geração anterior",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/auth/refresh",
                "auth": {
                  "type": "noauth"
                },
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                      "if (pm.response.code === 200) {",
                      "    pm.collectionVariables.set(\"refreshAnterior\", pm.collectionVariables.get(\"refreshToken\"));",
                      "    const resposta = pm.response.json();",
                      "    pm.collectionVariables.set(\"accessToken\", resposta.accessToken);",
                      "    pm.collectionVariables.set(\"refreshToken\", resposta.refreshToken);",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Reutilizar o refresh anterior",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/auth/refresh",
                "auth": {
                  "type": "noauth"
                },
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{refreshAnterior}}\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
                      "if (pm.response.code === 401) {",
                      "    pm.test(\"Mensagem genérica\", () => pm.expect(pm.response.json().mensagem).to.eql(\"Refresh token inválido ou expirado\"));",
                      "}"
                    ]
                  }
                }
              ]
            },
            {
              "name": "Tentar renovar a geração atual após replay",
              "request": {
                "method": "POST",
                "url": "{{base_url}}/auth/refresh",
                "auth": {
                  "type": "noauth"
                },
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
                      "if (pm.response.code === 401) {",
                      "    pm.test(\"Mensagem genérica\", () => pm.expect(pm.response.json().mensagem).to.eql(\"Refresh token inválido ou expirado\"));",
                      "}"
                    ]
                  }
                }
              ]
            }
          ]
        },
