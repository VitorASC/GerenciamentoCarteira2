{
  "info": {
    "name": "GestãoAtiva | Aulas 13 e 14",
    "description": "Use contas e banco locais descartáveis. Configure credenciais em variáveis locais do ambiente do Postman. Execute manualmente o cadastro e as operações de alteração de perfil.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "usuario_alvo_id",
      "value": ""
    },
    {
      "key": "token_padrao",
      "value": ""
    },
    {
      "key": "token_admin",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticação e autorização",
      "item": [
        {
          "name": "Login PADRAO",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_padrao}}\",\n  \"senha\": \"{{senha_padrao}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    const resposta = pm.response.json();",
                  "    pm.test(\"Perfil da conta\", () => pm.expect(resposta.perfilAcesso).to.eql(\"PADRAO\"));",
                  "    pm.test(\"Token Bearer\", () => pm.expect(resposta.accessToken).to.be.a(\"string\").and.not.be.empty);",
                  "    pm.collectionVariables.set(\"token_padrao\", resposta.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login ADMIN",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_admin}}\",\n  \"senha\": \"{{senha_admin}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    const resposta = pm.response.json();",
                  "    pm.test(\"Perfil da conta\", () => pm.expect(resposta.perfilAcesso).to.eql(\"ADMIN\"));",
                  "    pm.test(\"Token Bearer\", () => pm.expect(resposta.accessToken).to.be.a(\"string\").and.not.be.empty);",
                  "    pm.collectionVariables.set(\"token_admin\", resposta.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Carteiras sem Bearer",
          "request": {
            "method": "GET",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/carteiras",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "carteiras"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Carteiras com Bearer malformado",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "token-invalido",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/carteiras",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "carteiras"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "Carteiras com Bearer de PADRAO",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_padrao}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/carteiras",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "carteiras"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listagem de usuários negada para PADRAO",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_padrao}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listagem de usuários permitida para ADMIN",
          "request": {
            "method": "GET",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_admin}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Cadastro e alteração de perfil",
      "item": [
        {
          "name": "Cadastro público ignora ADMIN enviado",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/usuarios",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nomeCompleto\": \"Conta de teste\",\n  \"cpf\": \"{{cpf_padrao}}\",\n  \"email\": \"{{email_padrao}}\",\n  \"senha\": \"{{senha_padrao}}\",\n  \"perfilInvestidor\": \"MODERADO\",\n  \"perfilAcesso\": \"ADMIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if (pm.response.code === 201) {",
                  "    const conta = pm.response.json();",
                  "    pm.test(\"Cadastro é PADRAO\", () => pm.expect(conta.perfilAcesso).to.eql(\"PADRAO\"));",
                  "    pm.collectionVariables.set(\"usuario_alvo_id\", String(conta.id));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Promoção negada para PADRAO",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_padrao}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/usuarios/{{usuario_alvo_id}}/perfil-acesso",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios",
                "{{usuario_alvo_id}}",
                "perfil-acesso"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"perfilAcesso\": \"ADMIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", () => pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Promover outra conta como ADMIN",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_admin}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/usuarios/{{usuario_alvo_id}}/perfil-acesso",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios",
                "{{usuario_alvo_id}}",
                "perfil-acesso"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"perfilAcesso\": \"ADMIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Perfil atualizado\", () => pm.expect(pm.response.json().perfilAcesso).to.eql(\"ADMIN\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rebaixar outra conta como ADMIN",
          "request": {
            "method": "PUT",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token_admin}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{base_url}}/usuarios/{{usuario_alvo_id}}/perfil-acesso",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "usuarios",
                "{{usuario_alvo_id}}",
                "perfil-acesso"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"perfilAcesso\": \"PADRAO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Perfil atualizado\", () => pm.expect(pm.response.json().perfilAcesso).to.eql(\"PADRAO\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
