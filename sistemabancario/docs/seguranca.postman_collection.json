  "item": [
    {
      "name": "Autenticação e autorização",
      "item": [
        {
          "name": "Login PADRAO",
          "request": {
            "method": "POST",
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email_padrao}}\",\n  \"senha\": \"{{senha_padrao}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "    const resposta = pm.response.json();",
                  "    pm.test(\"Perfil da conta\", () => pm.expect(resposta.perfilAcesso).to.eql(\"PADRAO\"));",
                  "    pm.test(\"Token Bearer\", () => pm.expect(resposta.accessToken).to.be.a(\"string\").and.not.be.empty);",
                  "    pm.collectionVariables.set(\"token_padrao\", resposta.accessToken);",
                  "    pm.collectionVariables.set(\"accessToken\", resposta.accessToken);",
                  "    pm.collectionVariables.set(\"refreshToken\", resposta.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login ADMIN",
