                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Perfil atualizado\", () => pm.expect(pm.response.json().perfilAcesso).to.eql(\"PADRAO\"));"
                ]
              }
            }
          ]
